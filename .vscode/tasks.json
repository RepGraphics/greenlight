{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Greenlight: Start desktop debugger",
      "type": "shell",
      "command": "yarn",
      "args": ["desktop", "nextron", "dev", "--renderer-port", "8888", "--startup-delay", "30000"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "DEBUG": "greenlight:electron" }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "greenlight-desktop",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[nextron\\] Run renderer process:",
          "endsPattern": "^\\[nextron\\] Run main process:"
        }
      }
    },
    {
      "label": "Greenlight: Desktop smoke test",
      "type": "shell",
      "command": "yarn",
      "args": ["desktop", "test:smoke"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
