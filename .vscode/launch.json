{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nextron: Main",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9292,
      "restart": true,
      "timeout": 30000,
      "skipFiles": ["<node_internals>/**"],
      "sourceMapPathOverrides": {
        "webpack://greenlight-desktop/./*": "${workspaceFolder}/packages/desktop/*",
        "webpack:///./*": "${workspaceFolder}/packages/desktop/*"
      }
    },
    {
      "name": "Nextron: Renderer",
      "type": "chrome",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 5858,
      "timeout": 30000,
      "urlFilter": "http://localhost:8888/home*",
      "webRoot": "${workspaceFolder}/packages/desktop/renderer"
    }
  ],
  "compounds": [
    {
      "name": "Nextron: All",
      "preLaunchTask": "Greenlight: Start desktop debugger",
      "stopAll": true,
      "configurations": ["Nextron: Main", "Nextron: Renderer"]
    }
  ]
}
